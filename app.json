{
  "name": "AdsNova-Pro-Bot",
  "description": "AdsNova Pro Telegram Automation Bot",
  "repository": "https://github.com/mosameer2098-ship-it/Ads-",
  "keywords": [
    "telegram",
    "bot",
    "adsnova",
    "automation"
  ],
  "env": {
    "BOT_TOKEN": {
      "description": "Telegram Bot Token from @BotFather",
      "required": true
    },
    "API_ID": {
      "description": "Telegram API ID from my.telegram.org",
      "required": true
    },
    "API_HASH": {
      "description": "Telegram API Hash from my.telegram.org",
      "required": true
    },
    "ADMIN_ID": {
      "description": "Telegram numeric Admin User ID",
      "required": true
    },
    "BOT_USERNAME": {
      "description": "Bot username without @",
      "required": true
    },
    "FORCE_CHANNEL_USERNAME": {
      "description": "Force join channel username, with or without @",
      "required": true
    },
    "ADMIN_CONTACT_USERNAME": {
      "description": "Admin Telegram username without @",
      "required": true
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "Basic"
    }
  }
}
